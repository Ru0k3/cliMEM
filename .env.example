# ── cliMEM configuration ──────────────────────────────────────────────────────
# Copy this file to .env and fill in your own values:
#     cp .env.example .env
#
# .env holds secrets and is git-ignored — never commit it.

# ── AI provider (OpenAI-compatible endpoint that your CLI agent will reach
#    THROUGH the cliMEM proxy). Any OpenAI-compatible provider works.
PROVIDER_NAME=NVIDIA
PROVIDER_API_KEY=nvapi-REPLACE-WITH-YOUR-KEY
PROVIDER_BASE_URL=https://integrate.api.nvidia.com/v1

# ── Model aliases ─────────────────────────────────────────────────────────────
# "proxy" is the default model used by agents configured through cliMEM.
# The other aliases let you switch models per-agent (e.g. MODEL_CLAUDE).
# IMPORTANT: verify each model ID actually works on your provider — some
# model IDs are listed in /v1/models but fail on invocation.
MODEL_PROXY=moonshotai/kimi-k2-instruct
MODEL_KIMI=moonshotai/kimi-k2-instruct
MODEL_CLAUDE=openai/gpt-oss-120b
MODEL_CODEX=openai/gpt-oss-120b

# Optional backup models for the "proxy" hop, tried in order when the primary
# model keeps returning transient errors (429/5xx/404). Leave empty to disable.
# Example: MODEL_FALLBACK=openai/gpt-4o-mini,moonshotai/kimi-k2-instruct
MODEL_FALLBACK=

# ── Which CLI agent you'll route through cliMEM: opencode | claude | codex
CLI_TOOL=opencode

# ── Cognee (the memory engine). Local mode needs no extra services.
LLM_PROVIDER=custom
LLM_API_KEY=nvapi-REPLACE-WITH-YOUR-KEY
LLM_MODEL=nvidia_nim/moonshotai/kimi-k2-instruct
LLM_ENDPOINT=https://integrate.api.nvidia.com/v1
VECTOR_DB_PROVIDER=lancedb
GRAPH_DATABASE_PROVIDER=kuzu

EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSIONS=384
EMBEDDING_MAX_TOKENS=256

COGNEE_MODE=local
